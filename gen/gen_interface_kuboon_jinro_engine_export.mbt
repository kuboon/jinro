          Only(payload33) => {
            mbt_ffi_store8(iter_base + 0, 2)

            let address35 = mbt_ffi_malloc(payload33.length() * 8)
            for index36 = 0; index36 < payload33.length(); index36 = index36 + 1 {
              let iter_elem : String = payload33[index36]
              let iter_base = address35 + index36 * 8

              let ptr34 = mbt_ffi_str2ptr(iter_elem)
              mbt_ffi_store32(iter_base + 4, iter_elem.length())
              mbt_ffi_store32(iter_base + 0, ptr34)
            }
            mbt_ffi_store32(iter_base + 8, payload33.length())
            mbt_ffi_store32(iter_base + 4, address35)

            ()
          }
        }
        mbt_ffi_store8(iter_base + 12, iter_elem.action_type.ordinal())

        match iter_elem.actor {
          None => {
            mbt_ffi_store8(iter_base + 16, 0)

            ()
          }
          Some(payload38) => {
            mbt_ffi_store8(iter_base + 16, 1)

            let ptr39 = mbt_ffi_str2ptr(payload38)
            mbt_ffi_store32(iter_base + 24, payload38.length())
            mbt_ffi_store32(iter_base + 20, ptr39)

            ()
          }
        }

        match iter_elem.target {
          None => {
            mbt_ffi_store8(iter_base + 28, 0)

            ()
          }
          Some(payload41) => {
            mbt_ffi_store8(iter_base + 28, 1)

            let ptr42 = mbt_ffi_str2ptr(payload41)
            mbt_ffi_store32(iter_base + 36, payload41.length())
            mbt_ffi_store32(iter_base + 32, ptr42)

            ()
          }
        }

        match iter_elem.log_result {
          None => {
            mbt_ffi_store8(iter_base + 40, 0)

            ()
          }
          Some(payload44) => {
            mbt_ffi_store8(iter_base + 40, 1)

            match payload44 {
              Dead => {
                mbt_ffi_store8(iter_base + 41, 0)

                ()
              }
              Guarded => {
                mbt_ffi_store8(iter_base + 41, 1)

                ()
              }
              Partnered => {
                mbt_ffi_store8(iter_base + 41, 2)

                ()
              }
              Wolf => {
                mbt_ffi_store8(iter_base + 41, 3)

                ()
              }
              NonWolf => {
                mbt_ffi_store8(iter_base + 41, 4)

                ()
              }
            }

            ()
          }
        }
      }
      mbt_ffi_store32(return_area + 24, payload.0.logs.length())
      mbt_ffi_store32(return_area + 20, address50)

      match payload.1.rule.vote {
        Public => {
          mbt_ffi_store8(return_area + 28, 0)

          ()
        }
        Private => {
          mbt_ffi_store8(return_area + 28, 1)

          ()
        }
      }

      let address59 = mbt_ffi_malloc(payload.1.creatures.length() * 20)
      for index60 = 0
          index60 < payload.1.creatures.length()
          index60 = index60 + 1 {
        let iter_elem : @engine.Creature = payload.1.creatures[index60]
        let iter_base = address59 + index60 * 20

        let ptr54 = mbt_ffi_str2ptr(iter_elem.id)
        mbt_ffi_store32(iter_base + 4, iter_elem.id.length())
        mbt_ffi_store32(iter_base + 0, ptr54)
        mbt_ffi_store8(iter_base + 8, iter_elem.role.role_type.ordinal())

        let address57 = mbt_ffi_malloc(iter_elem.role.opts.length() * 16)
        for index58 = 0
            index58 < iter_elem.role.opts.length()
            index58 = index58 + 1 {
          let iter_elem : (String, String) = iter_elem.role.opts[index58]
          let iter_base = address57 + index58 * 16

          let ptr55 = mbt_ffi_str2ptr(iter_elem.0)
          mbt_ffi_store32(iter_base + 4, iter_elem.0.length())
          mbt_ffi_store32(iter_base + 0, ptr55)

          let ptr56 = mbt_ffi_str2ptr(iter_elem.1)
          mbt_ffi_store32(iter_base + 12, iter_elem.1.length())
          mbt_ffi_store32(iter_base + 8, ptr56)
        }
        mbt_ffi_store32(iter_base + 16, iter_elem.role.opts.length())
        mbt_ffi_store32(iter_base + 12, address57)
      }
      mbt_ffi_store32(return_area + 36, payload.1.creatures.length())
      mbt_ffi_store32(return_area + 32, address59)

      let address88 = mbt_ffi_malloc(payload.1.days.length() * 20)
      for index89 = 0; index89 < payload.1.days.length(); index89 = index89 + 1 {
        let iter_elem : @engine.Day = payload.1.days[index89]
        let iter_base = address88 + index89 * 20
        mbt_ffi_store32(iter_base + 0, iter_elem.day_number)

        let address65 = mbt_ffi_malloc(iter_elem.actions.length() * 24)
        for index66 = 0
            index66 < iter_elem.actions.length()
            index66 = index66 + 1 {
          let iter_elem : @engine.Action = iter_elem.actions[index66]
          let iter_base = address65 + index66 * 24

          let ptr61 = mbt_ffi_str2ptr(iter_elem.actor)
          mbt_ffi_store32(iter_base + 4, iter_elem.actor.length())
          mbt_ffi_store32(iter_base + 0, ptr61)
          mbt_ffi_store8(iter_base + 8, iter_elem.action_type.ordinal())

          match iter_elem.target {
            None => {
              mbt_ffi_store8(iter_base + 12, 0)

              ()
            }
            Some(payload63) => {
              mbt_ffi_store8(iter_base + 12, 1)

              let ptr64 = mbt_ffi_str2ptr(payload63)
              mbt_ffi_store32(iter_base + 20, payload63.length())
              mbt_ffi_store32(iter_base + 16, ptr64)

              ()
            }
          }
        }
        mbt_ffi_store32(iter_base + 8, iter_elem.actions.length())
        mbt_ffi_store32(iter_base + 4, address65)

        let address86 = mbt_ffi_malloc(iter_elem.logs.length() * 44)
        for index87 = 0
            index87 < iter_elem.logs.length()
            index87 = index87 + 1 {
          let iter_elem : @engine.Log = iter_elem.logs[index87]
          let iter_base = address86 + index87 * 44

          match iter_elem.receivers {
            All => {
              mbt_ffi_store8(iter_base + 0, 0)

              ()
            }
            Afterall => {
              mbt_ffi_store8(iter_base + 0, 1)

              ()
            }
            Only(payload69) => {
              mbt_ffi_store8(iter_base + 0, 2)

              let address71 = mbt_ffi_malloc(payload69.length() * 8)
              for index72 = 0
                  index72 < payload69.length()
                  index72 = index72 + 1 {
                let iter_elem : String = payload69[index72]
                let iter_base = address71 + index72 * 8

                let ptr70 = mbt_ffi_str2ptr(iter_elem)
                mbt_ffi_store32(iter_base + 4, iter_elem.length())
                mbt_ffi_store32(iter_base + 0, ptr70)
              }
              mbt_ffi_store32(iter_base + 8, payload69.length())
              mbt_ffi_store32(iter_base + 4, address71)

              ()
            }
          }
          mbt_ffi_store8(iter_base + 12, iter_elem.action_type.ordinal())

          match iter_elem.actor {
            None => {
              mbt_ffi_store8(iter_base + 16, 0)

              ()
            }
            Some(payload74) => {
              mbt_ffi_store8(iter_base + 16, 1)

              let ptr75 = mbt_ffi_str2ptr(payload74)
              mbt_ffi_store32(iter_base + 24, payload74.length())
              mbt_ffi_store32(iter_base + 20, ptr75)

              ()
            }
          }

          match iter_elem.target {
            None => {
              mbt_ffi_store8(iter_base + 28, 0)

              ()
            }
            Some(payload77) => {
              mbt_ffi_store8(iter_base + 28, 1)

              let ptr78 = mbt_ffi_str2ptr(payload77)
              mbt_ffi_store32(iter_base + 36, payload77.length())
              mbt_ffi_store32(iter_base + 32, ptr78)

              ()
            }
          }

          match iter_elem.log_result {
            None => {
              mbt_ffi_store8(iter_base + 40, 0)

              ()
            }
            Some(payload80) => {
              mbt_ffi_store8(iter_base + 40, 1)

              match payload80 {
                Dead => {
                  mbt_ffi_store8(iter_base + 41, 0)

                  ()
                }
                Guarded => {
                  mbt_ffi_store8(iter_base + 41, 1)

                  ()
                }
                Partnered => {
                  mbt_ffi_store8(iter_base + 41, 2)

                  ()
                }
                Wolf => {
                  mbt_ffi_store8(iter_base + 41, 3)

                  ()
                }
                NonWolf => {
                  mbt_ffi_store8(iter_base + 41, 4)

                  ()
                }
              }

              ()
            }
          }
        }
        mbt_ffi_store32(iter_base + 16, iter_elem.logs.length())
        mbt_ffi_store32(iter_base + 12, address86)
      }
      mbt_ffi_store32(return_area + 44, payload.1.days.length())
      mbt_ffi_store32(return_area + 40, address88)
      mbt_ffi_store32(return_area + 48, payload.2.day_number)

      match payload.2.winner {
        None => {
          mbt_ffi_store8(return_area + 52, 0)

          ()
        }
        Some(payload91) => {
          mbt_ffi_store8(return_area + 52, 1)
          mbt_ffi_store8(return_area + 53, payload91.ordinal())

          ()
        }
      }

      let address100 = mbt_ffi_malloc(payload.2.creature_statuses.length() * 24)
      for index101 = 0
          index101 < payload.2.creature_statuses.length()
          index101 = index101 + 1 {
        let iter_elem : @engine.CreatureStatus = payload.2.creature_statuses[index101]
        let iter_base = address100 + index101 * 24

        let ptr92 = mbt_ffi_str2ptr(iter_elem.id)
        mbt_ffi_store32(iter_base + 4, iter_elem.id.length())
        mbt_ffi_store32(iter_base + 0, ptr92)
        mbt_ffi_store8(iter_base + 8, iter_elem.role_type.ordinal())
        mbt_ffi_store8(iter_base + 9, iter_elem.team.ordinal())

        let address96 = mbt_ffi_malloc(
          iter_elem.available_actions.length() * 12,
        )
        for index97 = 0
            index97 < iter_elem.available_actions.length()
            index97 = index97 + 1 {
          let iter_elem : @engine.AvailableAction = iter_elem.available_actions[index97]
          let iter_base = address96 + index97 * 12
          mbt_ffi_store8(iter_base + 0, iter_elem.action_type.ordinal())

          let address94 = mbt_ffi_malloc(iter_elem.targets.length() * 8)
          for index95 = 0
              index95 < iter_elem.targets.length()
              index95 = index95 + 1 {
            let iter_elem : String = iter_elem.targets[index95]
            let iter_base = address94 + index95 * 8

            let ptr93 = mbt_ffi_str2ptr(iter_elem)
            mbt_ffi_store32(iter_base + 4, iter_elem.length())
            mbt_ffi_store32(iter_base + 0, ptr93)
          }
          mbt_ffi_store32(iter_base + 8, iter_elem.targets.length())
          mbt_ffi_store32(iter_base + 4, address94)
        }
        mbt_ffi_store32(iter_base + 16, iter_elem.available_actions.length())
        mbt_ffi_store32(iter_base + 12, address96)

        match iter_elem.cause_of_death {
          None => {
            mbt_ffi_store8(iter_base + 20, 0)

            ()
          }
          Some(payload99) => {
            mbt_ffi_store8(iter_base + 20, 1)
            mbt_ffi_store8(iter_base + 21, payload99.ordinal())

            ()
          }
        }
      }
      mbt_ffi_store32(return_area + 60, payload.2.creature_statuses.length())
      mbt_ffi_store32(return_area + 56, address100)

      ()
    }
    Err(payload102) => {
      mbt_ffi_store8(return_area + 0, 1)

      match payload102 {
        DataError(payload103) => {
          mbt_ffi_store8(return_area + 4, 0)

          let ptr104 = mbt_ffi_str2ptr(payload103)
          mbt_ffi_store32(return_area + 12, payload103.length())
          mbt_ffi_store32(return_area + 8, ptr104)

          ()
        }
      }

      ()
    }
  }
  return return_area
}

///|
pub fn wasmExportProcessDayPostReturn(p0 : Int) -> Unit {
  match mbt_ffi_load8_u(p0 + 0) {
    0 => {
      mbt_ffi_free(mbt_ffi_load32(p0 + 4))

      for index = 0; index < mbt_ffi_load32(p0 + 16); index = index + 1 {
        let iter_base = mbt_ffi_load32(p0 + 12) + index * 8
        mbt_ffi_free(mbt_ffi_load32(iter_base + 0))
      }
      mbt_ffi_free(mbt_ffi_load32(p0 + 12))

      for index1 = 0; index1 < mbt_ffi_load32(p0 + 24); index1 = index1 + 1 {
        let iter_base = mbt_ffi_load32(p0 + 20) + index1 * 44

        match mbt_ffi_load8_u(iter_base + 0) {
          0 => ()
          1 => ()
          2 => {
            for index0 = 0
                index0 < mbt_ffi_load32(iter_base + 8)
                index0 = index0 + 1 {
              let iter_base = mbt_ffi_load32(iter_base + 4) + index0 * 8
              mbt_ffi_free(mbt_ffi_load32(iter_base + 0))
            }
            mbt_ffi_free(mbt_ffi_load32(iter_base + 4))
          }
          _ => panic()
        }

        match mbt_ffi_load8_u(iter_base + 16) {
          0 => ()
          1 => mbt_ffi_free(mbt_ffi_load32(iter_base + 20))
          _ => panic()
        }

        match mbt_ffi_load8_u(iter_base + 28) {
          0 => ()
          1 => mbt_ffi_free(mbt_ffi_load32(iter_base + 32))
          _ => panic()
        }
      }
      mbt_ffi_free(mbt_ffi_load32(p0 + 20))

      for index3 = 0; index3 < mbt_ffi_load32(p0 + 36); index3 = index3 + 1 {
        let iter_base = mbt_ffi_load32(p0 + 32) + index3 * 20
        mbt_ffi_free(mbt_ffi_load32(iter_base + 0))

        for index2 = 0
            index2 < mbt_ffi_load32(iter_base + 16)
            index2 = index2 + 1 {
          let iter_base = mbt_ffi_load32(iter_base + 12) + index2 * 16
          mbt_ffi_free(mbt_ffi_load32(iter_base + 0))
          mbt_ffi_free(mbt_ffi_load32(iter_base + 8))
        }
        mbt_ffi_free(mbt_ffi_load32(iter_base + 12))
      }
      mbt_ffi_free(mbt_ffi_load32(p0 + 32))

      for index7 = 0; index7 < mbt_ffi_load32(p0 + 44); index7 = index7 + 1 {
        let iter_base = mbt_ffi_load32(p0 + 40) + index7 * 20

        for index4 = 0
            index4 < mbt_ffi_load32(iter_base + 8)
            index4 = index4 + 1 {
          let iter_base = mbt_ffi_load32(iter_base + 4) + index4 * 24
          mbt_ffi_free(mbt_ffi_load32(iter_base + 0))

          match mbt_ffi_load8_u(iter_base + 12) {
            0 => ()
            1 => mbt_ffi_free(mbt_ffi_load32(iter_base + 16))
            _ => panic()
          }
        }
        mbt_ffi_free(mbt_ffi_load32(iter_base + 4))

        for index6 = 0
            index6 < mbt_ffi_load32(iter_base + 16)
            index6 = index6 + 1 {
          let iter_base = mbt_ffi_load32(iter_base + 12) + index6 * 44

          match mbt_ffi_load8_u(iter_base + 0) {
            0 => ()
            1 => ()
            2 => {
              for index5 = 0
                  index5 < mbt_ffi_load32(iter_base + 8)
                  index5 = index5 + 1 {
                let iter_base = mbt_ffi_load32(iter_base + 4) + index5 * 8
                mbt_ffi_free(mbt_ffi_load32(iter_base + 0))
              }
              mbt_ffi_free(mbt_ffi_load32(iter_base + 4))
            }
            _ => panic()
          }

          match mbt_ffi_load8_u(iter_base + 16) {
            0 => ()
            1 => mbt_ffi_free(mbt_ffi_load32(iter_base + 20))
            _ => panic()
          }

          match mbt_ffi_load8_u(iter_base + 28) {
            0 => ()
            1 => mbt_ffi_free(mbt_ffi_load32(iter_base + 32))
            _ => panic()
          }
        }
        mbt_ffi_free(mbt_ffi_load32(iter_base + 12))
      }
      mbt_ffi_free(mbt_ffi_load32(p0 + 40))

      for index10 = 0; index10 < mbt_ffi_load32(p0 + 60); index10 = index10 + 1 {
        let iter_base = mbt_ffi_load32(p0 + 56) + index10 * 24
        mbt_ffi_free(mbt_ffi_load32(iter_base + 0))

        for index9 = 0
            index9 < mbt_ffi_load32(iter_base + 16)
            index9 = index9 + 1 {
          let iter_base = mbt_ffi_load32(iter_base + 12) + index9 * 12

          for index8 = 0
              index8 < mbt_ffi_load32(iter_base + 8)
              index8 = index8 + 1 {
            let iter_base = mbt_ffi_load32(iter_base + 4) + index8 * 8
            mbt_ffi_free(mbt_ffi_load32(iter_base + 0))
          }
          mbt_ffi_free(mbt_ffi_load32(iter_base + 4))
        }
        mbt_ffi_free(mbt_ffi_load32(iter_base + 12))
      }
      mbt_ffi_free(mbt_ffi_load32(p0 + 56))
    }
    1 =>
      match mbt_ffi_load8_u(p0 + 4) {
        0 => mbt_ffi_free(mbt_ffi_load32(p0 + 8))
        _ => panic()
      }
    _ => panic()
  }
}
