import Aeneas
import Jinro.Core
open Aeneas Aeneas.Std Result

/-!
# Properties of the jinro rule engine

`Jinro.Core` is generated by Aeneas from `rust/jinro-core/src/lib.rs`, so
every theorem here is about the exact code that ships in the WASM component.

First milestone: small, non-looping functions.

Next targets (loops, need loop invariants):
- `resolve_death_chain` terminates: each death is a distinct creature, so the
  loop runs at most `roles.len()` times.
- `process_day` never revives anyone: `is_alive v' c → is_alive v c`.
- Information hiding: a creature only sees `All` logs and `Only` logs that list it.
-/

namespace jinro_core

/-- In-game death announcements never reveal a bite, a lovers' suicide or a
    hamster curse: they are all published as `Unknown`. -/
theorem public_death_action_hides (c : ActionType) :
    ∃ r, public_death_action c = ok r ∧
      r ≠ ActionType.Bite ∧ r ≠ ActionType.LoversSuicide ∧ r ≠ ActionType.HamsterCurse := by
  cases c <;> simp [public_death_action]

/-- Executions, on the other hand, are announced as executions. -/
theorem public_death_action_vote :
    public_death_action ActionType.Vote = ok ActionType.Vote := by
  simp [public_death_action]

/-- Every role is on exactly the team the rules say. -/
theorem team_of_wolf : team_of RoleType.Wolf = ok Team.Wolves := by simp [team_of]
theorem team_of_madman : team_of RoleType.Madman = ok Team.Wolves := by simp [team_of]
theorem team_of_lover : team_of RoleType.Lover = ok Team.Lovers := by simp [team_of]
theorem team_of_bitch : team_of RoleType.Bitch = ok Team.Lovers := by simp [team_of]

end jinro_core
