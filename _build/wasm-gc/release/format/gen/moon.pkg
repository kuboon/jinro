import {
  "kuboon/jinro/gen/interface/kuboon/jinro/engine" @engine,
}

warnings = "-44"

options(
  link: {
    "wasm": {
      "export-memory-name": "memory",
      "exports": [
        "mbt_ffi_cabi_realloc:cabi_realloc",
        "wasmExportCreateVillage:kuboon:jinro/engine#create-village",
        "wasmExportCreateVillagePostReturn:cabi_post_kuboon:jinro/engine#create-village",
        "wasmExportProcessDay:kuboon:jinro/engine#process-day",
        "wasmExportProcessDayPostReturn:cabi_post_kuboon:jinro/engine#process-day",
      ],
      "heap-start-address": 16,
    },
  },
)
